{
  "name": "zxcaml-colosseum-slides",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "slidev slides.zh.md --port 3030",
    "build": "slidev build slides.zh.md --base ./",
    "export": "slidev export slides.zh.md --output ../out/slides/zh.pdf",
    "clean": "rm -rf dist .slidev ../out/slides"
  },
  "devDependencies": {
    "@slidev/cli": "52.15.1",
    "@slidev/theme-default": "0.25.0",
    "playwright-chromium": "1.59.1"
  }
}
